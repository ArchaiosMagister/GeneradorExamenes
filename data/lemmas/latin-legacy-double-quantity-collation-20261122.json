        ],
        "inference": "Existe apoyo explícito para alterĭus; el uso de alterīus está descrito por la tradición gramatical y métricas históricas. Mantener las dos cantidades documentadas en el registro original.",
        "allowedIndexNormalization": false,
        "sourcePromotion": false
