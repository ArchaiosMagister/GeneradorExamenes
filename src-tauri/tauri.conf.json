{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Generador de Exámenes Latín y Griego",
  "version": "0.1.0",
  "identifier": "es.archaiosmagister.generadorexamenes",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Generador de Exámenes Latín y Griego",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Education",
    "shortDescription": "Generador offline de exámenes de Latín y Griego",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
